{
  "name": "ecentryui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format:check": "prettier --check package.json tsconfig.base.json tsconfig.json tsconfig.tests.json eslint.config.mjs vitest.config.ts playwright.config.ts packages apps tests",
    "test": "vitest",
    "test:e2e": "npm run build && playwright test",
    "registry:validate": "npm run build && node packages/registry-schema/dist/validate-repository.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
